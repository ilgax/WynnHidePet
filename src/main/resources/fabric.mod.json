{
  "schemaVersion": 1,
  "id": "wynnhidepet",
  "version": "${version}",
  "name": "WynnCraft Hide Pets",
  "description": "A kotlin mod for fabric to hide your pets in Wynncraft",
  "authors": [],
  "contact": {
    "homepage": "https://github.com/ilgax/Wynnhidepet",
    "issues": "https://github.com/ilgax/Wynnhidepet/issues"
  },
  "license": "GPL-3.0-or-later",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "dev.ilgax.wynnhidepet.client.WynnhidepetClient",
        "adapter": "kotlin"
      }
    ],
    "main": [
      {
        "value": "dev.ilgax.wynnhidepet.Wynnhidepet",
        "adapter": "kotlin"
      }
    ],
    "modmenu": [
      {
        "value": "dev.ilgax.wynnhidepet.client.ModMenuIntegration",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    {
      "config": "wynnhidepet.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-language-kotlin": ">=1.13.8",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config": "*"
  }
}
